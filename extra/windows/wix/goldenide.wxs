<?xml version="1.0" encoding="windows-1252"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product Name="GoldenIDE" Id="*" UpgradeCode="9c09a374-1135-4782-959f-2dec376a1dfa" Language="1033" Codepage="1252" Version="0.4.6" Manufacturer="GoldenIDE">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"/>
        <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed."/>
        <Icon Id="goldend-ide.exe" SourceFile=".\extra\windows\goldenide.ico"/>
        <WixVariable Id="WixUILicenseRtf" Value=".\extra\windows\wix\license.rtf"/>
        <Property Id="ARPPRODUCTICON" Value="goldend-ide.exe"/>
        <MediaTemplate EmbedCab="yes"/>
        <UIRef Id="WixUI_Minimal"/>

        <Feature Id="ProductFeature" Title="ConsoleApp" Level="1">
            <ComponentRef Id="GoldenIdeExe"/>
            <ComponentRef Id="GoldenIdeShortcut"/>
            <ComponentRef Id="ModifyPathEnv"/>
            <ComponentRef Id="ContextMenu"/>
        </Feature>

        <!-- Create directories -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="GoldenIdeProgramFiles" Name="GoldenIDE"/>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="GoldenIdeProgramMenu" Name="GoldenIDE"/>
            </Directory>
        </Directory>

        <!-- Application binaries -->
        <DirectoryRef Id="GoldenIdeProgramFiles">
            <Component Id="GoldenIdeExe" Guid="*">
                <File Id="GoldenIdeExeFile" Source=".\target\release-lto\goldend-ide.exe" Name="goldend-ide.exe" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="GoldenIdeProgramMenu">
            <!-- Application shortcut -->
            <Component Id="GoldenIdeShortcut" Guid="7d3d3a8e-febb-4759-8eca-873676d5066a">
                <Shortcut Id="GoldenIdeShortcutFile" Icon="goldend-ide.exe" Name="GoldenIDE" Description="Lightning-fast and Powerful Code Editor" Target="[GoldenIdeProgramFiles]goldend-ide.exe"/>
                <RemoveFolder Id="GoldenIdeProgramMenu" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\Microsoft\GoldenIDE" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="GoldenIdeProgramFiles">
            <!-- Add to PATH -->
            <Component Id="ModifyPathEnv" Guid="0581ccb0-5db8-4935-8b07-8f46bc2d7171" KeyPath="yes">
                <Environment Id="PathEnv" Value="[GoldenIdeProgramFiles]" Name="PATH" Permanent="no" Part="first" Action="set" System="yes"/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="TARGETDIR">
            <!-- Add context menu -->
            <Component Id="ContextMenu" Guid="22ad399b-1d77-416c-ae33-57e8f8511177">
                <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open GoldenIDE here\command">
                    <RegistryValue Type="string" Value="[GoldenIdeProgramFiles]goldend-ide.exe &quot;%V&quot;" KeyPath="yes"/>
                </RegistryKey>
                <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open GoldenIDE here">
                    <RegistryValue Type="string" Name="Icon" Value="[GoldenIdeProgramFiles]goldend-ide.exe"/>
                </RegistryKey>
            </Component>
        </DirectoryRef>
    </Product>
</Wix>
