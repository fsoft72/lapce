[Desktop Entry]
Version=1.0
Type=Application

Name=GoldenIDE
Comment=Lightning-fast and powerful code editor written in Rust
Categories=Development;IDE;
GenericName=Code Editor
StartupWMClass=goldenide

Icon=dev.goldenide.goldenide
Exec=goldend-ide %F
Terminal=false
MimeType=text/plain;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=goldend-ide --new %F
Icon=dev.goldenide.goldenide
